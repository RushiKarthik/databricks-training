**Schema (MySQL v5.7)**

    
    CREATE TABLE employees (
        emp_id INT,
        emp_name VARCHAR(50),
        department VARCHAR(50),
        salary INT,
        city VARCHAR(50),
        experience INT
    );
    
    INSERT INTO employees VALUES
